# Local development environment template.
# Copy to .env and fill in only the values you need. Never commit the real .env.

# Required: Discord bot token and PostgreSQL connection string.
TOKEN=
PG_URL=postgresql://user:password@localhost:5432/zync

# Optional: secondary test-bot token.
TEST_BOT=

# Optional: development guild for scoped slash-command syncing (core/bot.py).
DEV_GUILD_ID=
# Optional: separate test guild id exposed by utils/config.py.
TEST_GUILD_ID=

# Optional: global fallback log channel.
LOG_CHANNEL_ID=

# Optional: links shown in help and upgrade messages.
UPGRADE_URL=
SUPPORT_SERVER=
ADMIN_INVITE=
REG_INVITE=

# Optional runtime settings.
# SYNC_COMMANDS=0 disables slash-command syncing (useful for offline tests).
SYNC_COMMANDS=1
# ENABLE_JISHAKU=1 loads the optional jishaku extension (not installed by default).
ENABLE_JISHAKU=0

# Optional logging settings (defaults shown).
LOG_LEVEL=INFO
LOG_FILE=bot.log
LOG_MAX_BYTES=5242880
LOG_BACKUPS=3
